# Copy of the local lab settings. start-charter.bat creates private\compose.env from this file.
# The real compose.env is not committed. CHARTER_DB_PASSWORD is added on first launch.
#
# Autonomous planning needs all four values. A Claude example is:
# CHARTER_LLM_BASE_URL=https://api.anthropic.com
# CHARTER_LLM_API=anthropic
# CHARTER_LLM_API_KEY=paste-your-key-here
# CHARTER_LLM_MODEL=claude-sonnet-4-5
#
# Leave the four lines blank to use the dashboard for capture only.

CHARTER_LLM_BASE_URL=
CHARTER_LLM_API=
CHARTER_LLM_API_KEY=
CHARTER_LLM_MODEL=
